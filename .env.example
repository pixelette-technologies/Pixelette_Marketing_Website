# Server-only provider configuration. Keep real values outside Git.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
CONTACT_ALLOWED_ORIGINS=
CONTACT_PRIVACY_NOTICE_VERSION=
# Must be a canonical absolute path on persistent storage. Ephemeral serverless
# filesystems do not satisfy the durable receipt and replay contract.
MARKETING_CONTACT_STORE_DIR=
MARKETING_CONTACT_RATE_LIMIT_SECRET=
MARKETING_BD_STAGE_URL=
MARKETING_BD_STAGE_URL_SHA256=
MARKETING_TRANSPORT_SECRET=
MARKETING_DEFAULT_CAMPAIGN_ID=
MARKETING_RETENTION_REVIEW_DAYS=
# Protected Preview-only synthetic journey. This endpoint is hard-disabled in
# Production and sends no email, public content or live-learning mutation.
MARKETING_SYNTHETIC_STAGE_ENABLED=
MARKETING_SYNTHETIC_STAGE_TRIGGER_SECRET=
MARKETING_SYNTHETIC_STAGE_DAILY_WRITE_LIMIT=

# Public, non-secret form-governance configuration.
NEXT_PUBLIC_CONTACT_PRIVACY_NOTICE_URL=
NEXT_PUBLIC_CONTACT_PRIVACY_NOTICE_VERSION=
NEXT_PUBLIC_CONTACT_CONSENT_TEXT=
