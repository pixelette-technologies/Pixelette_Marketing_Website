# Server-only provider configuration. Keep real values outside Git.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
CONTACT_ALLOWED_ORIGINS=
CONTACT_PRIVACY_NOTICE_VERSION=
