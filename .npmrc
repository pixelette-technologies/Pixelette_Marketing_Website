# @pixelette/agent today installs from a local file: path
# ("file:../pix-agent"); install-links makes that install copy the package
# tree and run its "prepare" script, the same way a git install will once
# the agent moves to its own private repository, rather than npm's default
# symlink (which skips "prepare" and resolves react outside this project).
install-links=true

# Forward-compatible for the move to a git dependency
# ("@pixelette/agent": "git+https://github.com/pixelette-technologies/pixelette-agent.git#<ref>").
# npm 12+ refuses to fetch any git dependency until the project opts in;
# "root" allows only git dependencies declared in this project's own
# package.json, not transitive ones. Today's `file:` install does not need
# this, but committing it now means the later move to git needs no new
# npmrc change. See allowScripts in package.json for the matching
# script-execution opt-in, and reports/Private agent delivery plan.md in the
# pix-agent repository for the full reasoning.
allow-git=root
